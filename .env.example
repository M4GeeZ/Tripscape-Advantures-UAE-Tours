PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/tripscape
CLIENT_URL=http://localhost:5173

# Booking confirmation email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@tripscapeadventures.com
SMTP_PASS=your-email-password-or-app-password
SMTP_FROM_NAME=Tripscape Adventures
SMTP_FROM_EMAIL=info@tripscapeadventures.com
BOOKING_TO_EMAIL=info@tripscapeadventures.com

# Optional: automatic WhatsApp confirmation to the customer's WhatsApp number.
# Requires Meta WhatsApp Cloud API credentials and an approved template.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_CONFIRMATION_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_GRAPH_VERSION=v23.0
