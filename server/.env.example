PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/tripscape
CLIENT_URL=https://tripscapetourism.com
CLIENT_URLS=

BOOKING_FALLBACK_FILE=data/bookings.ndjson
BOOKING_FALLBACK_QUEUE_DIR=data/booking-notification-queue
BOOKING_RETRY_INTERVAL_MS=600000
BOOKING_RETRY_AFTER_MS=600000
BOOKING_NOTIFICATION_MAX_ATTEMPTS=5
# One-time recovery switch for jobs that exhausted attempts while SMTP was misconfigured.
# Start the server once with this set to true, then remove it or set it back to false.
BOOKING_FORCE_RETRY_FAILED=false

# Verified for the Tripscape Zoho mailbox. Use the exact server shown in
# Zoho Mail > Settings > Mail Accounts > Server Configuration if it changes.
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@tripscapetourism.com
SMTP_PASS=PUT_YOUR_REAL_ZOHO_APP_PASSWORD_HERE
SMTP_FROM_NAME=Tripscape Tourism
SMTP_FROM_EMAIL=info@tripscapetourism.com
BOOKING_TO_EMAIL=info@tripscapetourism.com

# Optional WhatsApp Cloud API. Email-only bookings work with these left blank.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_CUSTOMER_TEMPLATE=tripscape_booking_received
WHATSAPP_CONFIRMATION_TEMPLATE=
WHATSAPP_COMPANY_TEMPLATE=tripscape_new_booking_alert
BOOKING_WHATSAPP_TO=971549930684

# Optional backup SMTP provider. If the primary SMTP login/send fails,
# the booking system automatically tries this provider for BOTH company
# and customer confirmation emails.
# Example: use Gmail as fallback with a Google App Password.
SMTP_FALLBACK_HOST=smtp.gmail.com
SMTP_FALLBACK_PORT=465
SMTP_FALLBACK_SECURE=true
SMTP_FALLBACK_USER=
SMTP_FALLBACK_PASS=
SMTP_FALLBACK_FROM_NAME=Tripscape Tourism
SMTP_FALLBACK_FROM_EMAIL=
SMTP_FALLBACK_AUTH_METHOD=

# Optional backup copy of each company booking alert.
# Keep BOOKING_TO_EMAIL as the official company mailbox.
BOOKING_ALERT_EMAIL=

# Instagram feed ("Fresh from Instagram" on tour pages). Official API token of @tripscapeadventures.
# Leave blank to hide the section. The token lasts 60 days: renew with `npm run instagram:refresh`.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USERNAME=tripscapeadventures
